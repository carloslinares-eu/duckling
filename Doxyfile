# Minimal Doxygen config for duckling. Run: doxygen Doxyfile
PROJECT_NAME           = duckling
PROJECT_BRIEF          = "Logitech mouse + keyboard follow each other across hosts"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = src
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
JAVADOC_AUTOBRIEF      = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
# Embed the PlantUML diagrams with \startuml / \enduml or
# \image after rendering. Set the path if plantuml.jar is installed:
PLANTUML_JAR_PATH      =
PLANTUML_INCLUDE_PATH  = docs/architecture
