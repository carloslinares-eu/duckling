# duckling_embed_fixtures(<out_cpp> <glob>...)
#
# Embed text fixtures (the hw-logs/ recordings) into a generated C++ file, so
# the test binary is self-contained and runs on any machine, including a
# cross-built .exe copied to Windows.
#
# The generated file defines duckling::test::embeddedLogs() (declared in
# tests/fixtures.hpp). Contents are emitted as byte arrays rather than string
# literals, which avoids MSVC's string-literal size limits. CMake
# re-configures when a matching file is added, removed or changed.
function(duckling_embed_fixtures out_cpp)
  file(GLOB files CONFIGURE_DEPENDS ${ARGN})
  list(SORT files)

  set(arrays "")
  set(entries "")
  set(i 0)
  foreach(f IN LISTS files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${f}")
    get_filename_component(name "${f}" NAME)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # A trailing 0 keeps the array non-empty for empty files; size excludes it.
    string(APPEND arrays "const unsigned char kLog${i}[] = {${bytes}0};\n")
    string(APPEND entries "        {\"${name}\", {reinterpret_cast<const char*>(kLog${i}), ${size}}},\n")
    math(EXPR i "${i} + 1")
  endforeach()

  set(content "// Generated by cmake/EmbedFixtures.cmake. Do not edit.
#include \"fixtures.hpp\"

namespace duckling::test {

namespace {
${arrays}}  // namespace

const std::vector<EmbeddedLog>& embeddedLogs() {
    static const std::vector<EmbeddedLog> logs = {
${entries}    };
    return logs;
}

}  // namespace duckling::test
")
  # Write via a temp file so the .cpp only changes (and recompiles) on change.
  file(WRITE "${out_cpp}.tmp" "${content}")
  configure_file("${out_cpp}.tmp" "${out_cpp}" COPYONLY)
endfunction()
