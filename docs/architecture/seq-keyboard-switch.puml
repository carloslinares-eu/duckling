@startuml seq-keyboard-switch
' Keyboard Easy-Switch pressed on carbon -> mouse follows (PLAN.md decision 7)

title Keyboard leaves carbon (ch3) for Windows (ch1): mouse follows

actor User
participant "MX Mechanical" as kbd
participant "MX Master 3S" as mouse
participant "Receiver\n(carbon)" as rx
participant "duckling\n(carbon)" as dc
participant "duckling\n(Windows)" as dw

dw -> dc : HELLO {DESKTOP-CARLOS, ch1} (every 2 s)
User -> kbd : press Easy-Switch 1
kbd -> rx : CHANGE_HOST event [from=2, to=0]
rx -> dc : 11 01 09 00 02 00
dc -> dc : target = HOSTS_INFO(kbd)[0] = DESKTOP-CARLOS
alt peer DESKTOP-CARLOS alive (HELLO < 6 s ago)
  dc -> rx : setCurrentHost(mouse, ch = channelOf(mouse, DESKTOP-CARLOS))
  rx -> mouse
  mouse --> rx : ack
  rx --> dc : 11 02 0A 1D 00
  dc -> dc : suppress(mouse, 5 s)
  rx -> dc : 0x41 keyboard OFFLINE
  rx -> dc : 0x41 mouse OFFLINE (suppressed)
  kbd -> dw : connects
  mouse -> dw : connects
  dw -> dc : ARRIVED kbd / mouse (ignored: nothing pending)
else peer not alive
  dc -> dc : log "target off, not following" (C3)
  rx -> dc : 0x41 keyboard OFFLINE
end

@enduml
