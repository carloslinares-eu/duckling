@startuml classes
' duckling: internal software architecture (one process)
' Render: plantuml docs/architecture/*.puml

title duckling: software architecture

skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

package "app" {
  class Main <<entry>> {
    +main(argc, argv) : int
    -- subcommands --
    run | status | switch | sniff | gen-secret | version
  }
  class Daemon {
    +Daemon(Config)
    +run() : int
    +stop()
  }
  class Status <<utility>> {
    +collectStatus(Requester&, receiver, thisHost) : StatusReport
    +formatStatus(StatusReport) : string
    +localHostName() : string
    +runStatus() : int
  }
  class StatusReport <<value>> {
    receiver : string
    thisHost : string
    devices : vector<DeviceStatus>
    problems : vector<string>
  }
  class DeviceStatus <<value>> {
    pairing : PairingInfo
    codename : string
    version : optional<ProtocolVersion>
    pingFailure : optional<Failure>
    name : string
    features : optional<DeviceFeatures>
    host : optional<HostInfo>
    hostNames : vector<HostName>
    problems : vector<string>
    +here() : bool
  }
}

package "core" {
  class Router {
    +Router(Clock&, HidActions&, NetActions&, Config&)
    +onEvent(const Event&)
    +onTick()
    -devices_ : map<uint8_t, DeviceState>
    -peers_ : map<string, Peer>
    -pending_ : map<uint16_t, PendingFollow>
    -suppress_ : map<uint16_t, TimePoint>
    -peerAlive(host) : bool
    -channelOf(wpid, host) : optional<uint8_t>
  }
  class EventQueue {
    +push(Event)
    +popUntil(TimePoint) : optional<Event>
  }
  class "Event" as Event <<variant>> {
    hidpp::DeviceConnection
    hidpp::HostChange
    PeerHello
    PeerArrived
  }
  class Peer {
    hostname : string
    lastHello : TimePoint
    channels : map<uint16_t, uint8_t>
  }
  class PendingFollow {
    wpid : uint16_t
    deadline : TimePoint
  }
  interface Clock {
    +now() : TimePoint
  }
  interface HidActions {
    +setHost(index, channel) : bool
  }
  interface NetActions {
    +sendArrived(wpid, channel)
  }
  class Config {
    secret : bytes
    port : uint16_t
    hostname : string
    overrides : map
    +load(path) : Config
  }
  class StateCache {
    +load() / save()
    ownChannels : map<uint16_t, uint8_t>
    hostNames : map<uint16_t, array<string,3>>
  }
}

package "io" {
  class ReceiverPaths {
    shortPath : string
    longPath : string
    serial : string
    productId : uint16_t
    +sharedHandle() : bool
  }
  class Receiver <<final>> {
    +{static} open(ReceiverPaths) : optional<Receiver>
    +{static} openFirst() : optional<Receiver>
    +isOpen() : bool
    +close()
    +paths() : const ReceiverPaths&
    +read(timeout) : optional<Report>
    +write(Report) : bool
    +request(Report, timeout = 2 s) : optional<Report>
    -short_ : hid_device*
    -long_ : hid_device*
    -pending_ : deque<Report>
    -timedOut_ : vector<TimedOut>
    -readErrors_ : int
  }
  note right of Receiver
    Linux: one hidraw node (short_ == long_).
    Windows: two collections, read in turn (long first);
    0x41 notices only arrive on the short one.
    Late replies to timed-out requests are dropped.
    Closes after 3 read errors in a row.
    Not thread-safe: in the daemon (2.6) only the
    HID thread uses it, requests are posted to it.
  end note
  class ReceiverFn <<utility>> {
    +findReceivers() : vector<ReceiverPaths>
    +collectionKey(path) : string
  }
  class Device {
    index : uint8_t
    wpid : uint16_t
    kind : Kind
    name : string
    changeHostIndex : uint8_t
    changeHostVersion : uint8_t
    online : bool
    ownChannel : uint8_t
    hostNames : array<string,3>
  }
  class HidWorker <<thread>> {
    +start(EventQueue&)
    -rescanEvery : 5 s
  }
}

package "hidpp" {
  enum ReportId {
    Short = 0x10 (7 B)
    Long = 0x11 (20 B)
  }
  class Report <<value>> {
    -bytes_ : array<uint8_t,20>
    -length_ : size_t
    +{static} make(id, deviceIndex, featureIndex, function, swId, params) : Report
    +{static} decode(span) : optional<Report>
    +encode() : vector<uint8_t>
    +bytes() : span<const uint8_t>
    +id() : ReportId
    +deviceIndex() / featureIndex() / functionByte() : uint8_t
    +function() / swId() : uint8_t
    +params() : span<const uint8_t>
    +param(i) : uint8_t
    +isError() : bool
  }
  class Hex <<utility>> {
    +toHex(span) : string
    +parseHex(string_view) : optional<vector<uint8_t>>
  }
  interface Requester {
    +{abstract} request(Report) : optional<Report>
  }
  class "Result<T>" as Result <<value>> {
    +ok() : bool
    +value() : const T&
    +failure() : const Failure&
  }
  class Failure <<value>> {
    kind : FailureKind
    code : uint8_t
    +deviceUnreachable() : bool
    +unknownDevice() : bool
  }
  enum FailureKind {
    Timeout
    Hidpp10
    Hidpp20
    Unsupported
    BadReply
  }
  class Features <<utility>> {
    +ping(Requester&, index) : Result<ProtocolVersion>
    +getFeature(Requester&, index, featureId) : Result<FeatureInfo>
    +discover(Requester&, index) : Result<DeviceFeatures>
    +getHostInfo(Requester&, index, changeHost) : Result<HostInfo>
    +setCurrentHost(Requester&, index, changeHost, host) : Result<Ack>
    +getHostNames(Requester&, index, hostsInfo) : Result<vector<HostName>>
    +getDeviceName(Requester&, index, deviceName) : Result<string>
    +describe(Failure) : string
  }
  class DeviceFeatures <<value>> {
    changeHost : uint8_t
    changeHostVersion : uint8_t
    hostsInfo : uint8_t
    deviceName : uint8_t
  }
  class HostName <<value>> {
    host : uint8_t
    paired : bool
    name : string
    nameRead : bool
  }
  class ReceiverInfo <<utility>> {
    +getPairingInfo(Requester&, slot) : Result<PairingInfo>
    +getCodename(Requester&, slot) : Result<string>
  }
  class PairingInfo <<value>> {
    slot : uint8_t
    linkUp : bool
    rawKind : uint8_t
    wpid : uint16_t
    serial : uint32_t
    +kind() : DeviceKind
  }
  note bottom of ReceiverInfo
    Bolt long register 0x2B5: sub 0x5N pairing,
    0x6N codename; empty slot = error 0x08 (r1).
    Works while the device is on another host.
  end note
  class EventParser {
    -slots_ : array<Slot{wpid, changeHost}, 7>
    +setChangeHostFeature(deviceIndex, wpid, featureIndex)
    +forgetDevice(deviceIndex)
    +parse(const Report&) : optional<hidpp::Event>
  }
  note right of EventParser
    Registration is dropped when the slot reports
    another wpid or an unpair notice (0x40).
    swId 0 = device event; requests use kDucklingSwId (0x1;
    Solaar cycles 0x2..0xF, Options+ uses 0xA/0xB).
  end note
  class "hidpp::Event" as HidppEvent <<variant>> {
    DeviceConnection | HostChange
  }
  class EventsFn <<utility>> {
    +parseDeviceConnection(const Report&) : optional<DeviceConnection>
    +toDeviceKind(raw) : DeviceKind
  }
  class DeviceConnection <<event>> {
    deviceIndex : uint8_t
    online : bool
    rawKind : uint8_t
    wpid : uint16_t
    +kind() : DeviceKind
  }
  class HostChange <<event>> {
    deviceIndex : uint8_t
    fromHost : uint8_t  (< 3)
    toHost : uint8_t  (< 3)
  }
  note bottom of HostChange
    11 i F 00 <from> <to>: sent ~37 ms before the
    link drops; button presses only, CHANGE_HOST V2
  end note
}

package "net" {
  class UdpSocket {
    +bind(port)
    +broadcast(bytes)
    +recv(timeout) : optional<Datagram>
  }
  class Message {
    type : HELLO | ARRIVED
    timestamp : uint64_t
    seq : uint32_t
    hostname : string
    devices : vector<pair<uint16_t,uint8_t>>
    +serialize(secret) : vector<uint8_t>
    +parse(bytes, secret) : optional<Message>
  }
  class ReplayGuard {
    +accept(host, seq, timestamp) : bool
  }
  class NetWorker <<thread>> {
    +start(EventQueue&)
    -helloEvery : 2 s
  }
  class HmacSha256 <<vendored>>
}

Main --> Daemon
Main ..> Status
Status ..> StatusReport
StatusReport --> DeviceStatus
Status ..> Features
Status ..> ReceiverInfo
Status ..> Receiver
ReceiverInfo ..> Requester
ReceiverInfo ..> PairingInfo
DeviceStatus --> PairingInfo
Daemon *-- Router
Daemon *-- EventQueue
Daemon *-- HidWorker
Daemon *-- NetWorker
Daemon --> Config
Daemon --> StateCache

HidWorker --> Receiver
HidWorker --> EventParser
HidWorker ..> EventQueue : push
NetWorker --> UdpSocket
NetWorker --> Message
NetWorker --> ReplayGuard
NetWorker ..> EventQueue : push
Message ..> HmacSha256

Router --> Clock
Router --> HidActions
Router --> NetActions
Router o-- Peer
Router o-- PendingFollow
Router ..> Event
Router ..> Device

Receiver ..> Report
Receiver --> ReceiverPaths
ReceiverFn ..> ReceiverPaths
Report --> ReportId
Requester <|.. Receiver
Features ..> Requester
Features ..> Report
Features ..> Result
Features ..> DeviceFeatures
Features ..> HostName
Result --> Failure
Failure --> FailureKind
EventParser ..> Report
EventParser ..> HidppEvent
EventParser ..> EventsFn
HidppEvent o-- DeviceConnection
HidppEvent o-- HostChange
Event o-- DeviceConnection
Event o-- HostChange

class ReceiverHidActions
class UdpNetActions
HidActions <|.. ReceiverHidActions
NetActions <|.. UdpNetActions
ReceiverHidActions --> Features
UdpNetActions --> UdpSocket

note right of Router
  Single owner of all state; runs only on the
  main thread. Rules: PLAN.md decisions 7-8.
  Clock/HidActions/NetActions are interfaces
  so tests can drive it with fakes.
end note

@enduml
